# --- OpenRouteService (server only; never exposed to the browser) ---
# Free key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# --- Supabase ---
# Server-side: service role key is used only in API routes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser: used only to subscribe to the realtime "changed" broadcast for an event.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave the Supabase vars empty to run with an in-memory store (dev/e2e only).
